# Copy this file to .env and fill in real local values.
# Never commit the real .env file.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Local PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbipes_dev?schema=public"

# --- Auth ---
# Generate a real random 32+ char secret for local/dev use, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-development-only-secret
JWT_EXPIRES_IN=8h

# --- CORS ---
# Comma separated list of origins allowed to call the API.
# For the React Native app during development this is typically not
# browser-origin based (native apps don't send an Origin header), but
# keep this documented for any web-based tooling (e.g. Prisma Studio, Postman).
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Phase 5 USP providers ---
# Sarvam speech-to-text is genuinely wired in (see
# backend/src/services/providers/sarvamTranscriptionProvider.ts) and
# activates automatically the moment this is set to a real key — no code
# change needed. Leave unset/commented to keep voice updates on the
# honest "not configured" fallback.
# SARVAM_API_KEY=

# The following remain NOT wired in yet — see docs/PHASE5_IMPLEMENTATION.md
# "Provider integration points" for exactly what each needs.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_BUSINESS_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
