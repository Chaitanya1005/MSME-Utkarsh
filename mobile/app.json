{
  "expo": {
    "name": "MSME Utkarsh",
    "slug": "msme-utkarsh",
    "version": "0.1.0",
    "platforms": [
      "android",
      "ios"
    ],
    "scheme": "cbipes",
    "icon": "./src/assets/app-icon.png",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "MSME Utkarsh needs microphone access so branch Heads can record voice lead updates."
        }
      ],
      "expo-asset"
    ],
    "android": {
      "package": "com.cbipestemp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "a90ac4b6-9a36-49be-89af-62545e2e09dc"
      }
    },
    "owner": "chaitanyas-team1005"
  }
}